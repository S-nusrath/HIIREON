<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4 p-4">

                <h2 class="text-center mb-4">
                    Add New Listing
                </h2>

                <form method="POST" action="/listings">

                    <!-- TITLE -->

                    <div class="mb-3">

                        <label class="form-label" for="title">
                            Title
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="title"
                            name="title"
                            placeholder="Enter listing title"
                            required
                        >

                    </div>

                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label class="form-label" for="description">
                            Description
                        </label>

                        <textarea
                            class="form-control"
                            id="description"
                            name="description"
                            rows="4"
                            placeholder="Write listing description"
                            required
                        ></textarea>

                    </div>

                    <!-- IMAGE URL -->

                    <div class="mb-3">

                        <label class="form-label" for="image">
                            Image URL
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="image"
                            name="image"
                            placeholder="Paste image URL"
                            required
                        >

                    </div>

                    <!-- PRICE -->

                    <div class="mb-3">

                        <label class="form-label" for="price">
                            Price
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            id="price"
                            name="price"
                            placeholder="Enter price"
                            required
                        >

                    </div>

                    <!-- LOCATION -->

                    <div class="mb-3">

                        <label class="form-label" for="location">
                            Location
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="location"
                            name="location"
                            placeholder="Enter location"
                            required
                        >

                    </div>

                    <!-- COUNTRY -->

                    <div class="mb-4">

                        <label class="form-label" for="country">
                            Country
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="country"
                            name="country"
                            placeholder="Enter country"
                            required
                        >

                    </div>

                    <!-- BUTTON -->

                    <div class="text-center">

                        <button class="btn btn-dark btn-lg px-4">
                            Add Listing
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>